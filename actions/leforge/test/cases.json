{
  "cases": [
    {
      "name": "run action: the input object is the body, dryRun in the query",
      "operation": "run_action",
      "inputs": {
        "action_id": "user.provision",
        "input": {
          "username": "ada"
        },
        "dryRun": "true"
      },
      "mocks": {
        "http": {
          "status": 200,
          "json": {
            "ok": true,
            "result": {
              "id": 7
            }
          }
        }
      },
      "expect_request": {
        "method": "POST",
        "url": "https://api.example.test/api/v1/actions/user.provision?dryRun=true",
        "body": {
          "username": "ada"
        }
      },
      "expect": {
        "ok": true,
        "result": {
          "id": 7
        }
      }
    },
    {
      "name": "publish event: nested template with a JSON payload",
      "operation": "publish_event",
      "inputs": {
        "type": "deploy.done",
        "payload": "{\"app\": \"site\", \"ok\": true}"
      },
      "expect_request": {
        "url": "https://api.example.test/api/v1/fabric/events",
        "body": {
          "event": {
            "type": "deploy.done",
            "payload": {
              "app": "site",
              "ok": true
            }
          }
        }
      }
    },
    {
      "name": "health: the body status is the status output",
      "operation": "health",
      "inputs": {},
      "mocks": {
        "http": {
          "status": 200,
          "json": {
            "status": "healthy"
          }
        }
      },
      "expect": {
        "status": "healthy",
        "http_status": 200
      }
    },
    {
      "name": "run action: a body with no ok field gives ok null, http_ok true",
      "operation": "run_action",
      "inputs": {
        "action_id": "x",
        "input": {}
      },
      "mocks": {
        "http": {
          "status": 200,
          "json": {
            "result": 1
          }
        }
      },
      "expect": {
        "ok": null,
        "http_ok": true
      }
    }
  ]
}
